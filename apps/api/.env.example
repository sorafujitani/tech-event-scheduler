GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# WEB_ORIGIN: where the browser SPA lives during dev (vite dev server)
WEB_ORIGIN=http://localhost:5173
# COOKIE_DOMAIN: "localhost" disables crossSubDomainCookies (vite proxy makes
# api+web look same-origin). Set the registrable parent domain in prod
# (e.g. fujitanisora0414.workers.dev).
COOKIE_DOMAIN=localhost
